#: forms.py:42
msgid "Username"
msgstr "Brukernavn"

#: forms.py:54
msgid "Username can only be set once"
msgstr "Brukernavn kan bare settes en gang"

#: validators.py:13
msgid "Enter a valid username."
msgstr "Skriv inn et gyldig brukernavn."

#: validators.py:14
msgid ""
"Between 3 and 32 characters. Lowercase letters and digits only. It must "
"start with a letter."
msgstr ""
"Mellom 3 og 32 tegn. Bare små bokstaver og tall. Må starte med en bokstav."

#: validators.py:586
#, python-format
msgid "%(value)s is not an allowed username"
msgstr "%(value)s er ikke et gyldig brukernavn"

#: validators.py:599
#, python-format
msgid "Username %(value)s is taken"
msgstr "Brukernavnet %(value)s er allerede i bruk"

#: views.py:16 views.py:32
msgid "Password changed"
msgstr "Passordet er endret"
